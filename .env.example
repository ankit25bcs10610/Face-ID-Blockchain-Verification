# Blockchain configuration
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
PRIVATE_KEY=replace_with_local_wallet_private_key
WALLET_ADDRESS=replace_with_local_wallet_address
CONTRACT_ADDRESS=
SOLIDITY_COMPILER_VERSION=0.8.20
CONTRACT_ARTIFACT_PATH=build/EvidenceRegistry.json
CHAIN_ID=0
BLOCKCHAIN_MODE=local

# Application configuration
API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_MAX_UPLOAD_BYTES=10485760
FACE_MODEL_NAME=buffalo_l
FACE_CTX_ID=-1
FACE_DET_SIZE=640
FACE_MIN_WIDTH=160
FACE_MIN_HEIGHT=160
FACE_MIN_QUALITY=0.0
FACE_MIN_CONFIDENCE=0.0
TOP_K=5
MATCH_THRESHOLD=0.80
FACE_SIMILARITY_WEIGHT=0.70
IMAGE_SIMILARITY_WEIGHT=0.20
METADATA_CONSISTENCY_WEIGHT=0.10
METADATA_FIELDS=platform,caption,timestamp
EVIDENCE_DIR=data/evidence
EVIDENCE_VERSION=1.0
ALLOW_MULTIPLE_FACES=false

# Live web/social-media search (genuine reverse-image search, not a local corpus)
# SEARCH_PROVIDER=authorized_dataset uses only the local data/posts corpus.
# SEARCH_PROVIDER=web_reverse_image requires SERPAPI_API_KEY (https://serpapi.com/).
SEARCH_PROVIDER=authorized_dataset
SERPAPI_API_KEY=
SERPAPI_ENDPOINT=https://serpapi.com/search.json
WEB_SEARCH_FACE_MATCH_THRESHOLD=0.35
WEB_SEARCH_CACHE_DIR=data/web_search_cache
WEB_SEARCH_MAX_CANDIDATES_SCANNED=15
WEB_SEARCH_MAX_ATTEMPTS=3

# Public image host used so Google/SerpAPI can actually fetch the query image
# (anonymous throwaway file hosts are not crawlable by Google's image fetcher;
# a GitHub-hosted raw file is). GITHUB_TOKEN is optional: if unset, the token
# is read from `gh auth token` at request time. The pushed image becomes a
# public file in this repo (not auto-deleted) -- see README known limitations.
GITHUB_TOKEN=
GITHUB_HOST_OWNER=
GITHUB_HOST_REPO=tracechain-search-cache
GITHUB_HOST_BRANCH=main
